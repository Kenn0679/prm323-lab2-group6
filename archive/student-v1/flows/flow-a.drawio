<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="780" pageHeight="1360"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Flow A - Onboarding và tạo hồ sơ" style="text;html=0;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="4" width="700" height="30" as="geometry" /></mxCell><mxCell id="a0" value="START&#10;Mở app lần đầu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#D5E8D4;strokeColor=#4C8A3C;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="55.0" y="54.0" width="250" height="56" as="geometry" /></mxCell><mxCell id="a1" value="S1 Onboarding&#10;Nhập email, nhận mã xác nhận" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#2E6DA4;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30.0" y="178.0" width="300" height="64" as="geometry" /></mxCell><mxCell id="a2" value="Email đúng&#10;định dạng?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="80.0" y="296.0" width="200" height="84" as="geometry" /></mxCell><mxCell id="a2e" value="LỖI: báo ngay dưới ô nhập&#10;'Nhập email hợp lệ'" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=0;fillColor=#FBE3E0;strokeColor=#C0392B;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="440.0" y="306.0" width="280" height="64" as="geometry" /></mxCell><mxCell id="a3" value="S2 Create profile&#10;Ngành, kỳ, 3-5 kỹ năng, vai trò" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#DAE8FC;strokeColor=#2E6DA4;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="30.0" y="434.0" width="300" height="64" as="geometry" /></mxCell><mxCell id="a4" value="Đủ trường&#10;bắt buộc?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF2CC